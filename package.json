{
  "name": "dsh-wtq-pool",
  "displayName": "WTQ Pool",
  "description": "将本机 WorkBuddy、Trae、Qoder 桌面登录接入 DeepSeek Harness，并在账号不可用时自动切换。",
  "version": "1.4.0",
  "license": "MIT",
  "author": "chengzhi-c",
  "homepage": "https://github.com/chengzhi-c/dsh-wtq-pool#readme",
  "bugs": {
    "url": "https://github.com/chengzhi-c/dsh-wtq-pool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhi-c/dsh-wtq-pool.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "trae",
    "qoder",
    "model-provider",
    "multi-account",
    "failover"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-alpha.2 <0.2.4-0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "renderer",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=60000 \"tests/*.test.cjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1",
    "@earendil-works/pi-ai": "1.6.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0 || >=4.2.0-alpha.1 <4.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-alpha.2 <0.2.4-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-alpha.2 <0.2.4-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-alpha.2 <0.2.4-0",
    "@deepseek-ai/schemastery": "^3.18.4 || >=3.20.0-alpha.1 <3.21.0-0",
    "@earendil-works/pi-ai": ">=0.87.1 <0.88.0 || >=1.3.0 <2.0.0-0"
  }
}
