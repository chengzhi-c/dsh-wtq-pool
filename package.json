{
  "name": "dsh-wtq-pool",
  "displayName": "WTQ Pool",
  "description": "把本机 WorkBuddy、Trae、Qoder 的桌面登录接入 DeepSeek Harness。限流或额度用尽时自动换号，三家各自开关，国内与国际账号分别成组。",
  "version": "1.1.0",
  "license": "MIT",
  "author": "chengzhi-c",
  "homepage": "https://github.com/chengzhi-c/dsh-wtq-pool#readme",
  "bugs": {
    "url": "https://github.com/chengzhi-c/dsh-wtq-pool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhi-c/dsh-wtq-pool.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "trae",
    "qoder",
    "model-provider",
    "multi-account",
    "failover"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.2.1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "renderer",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm run build",
    "prepack": "tsdown",
    "prepublishOnly": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "pretest": "tsdown",
    "test": "node --test --test-timeout=60000 \"tests/*.test.cjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@earendil-works/pi-ai": "^0.87.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@earendil-works/pi-ai": ">=0.82.1 <0.88.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  }
}
