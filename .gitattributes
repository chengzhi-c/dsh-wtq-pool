# Keep line endings as committed. core.autocrlf=true on Windows otherwise
# rewrites every checkout, so the next person would see a whole-file diff on a
# one-line change - and the LF/CRLF mix that produced.
* text=auto eol=lf

# The packed plugin is binary: a diff of it is never useful, and git must not
# try to normalise the bytes.
dist/*.tgz binary

# Built output, regenerated by tsdown from src/. Tracked anyway so an install
# can run without a build step, but marked so the blob is untouched.
lib/** -text

# README screenshots: binary, so git must not normalise the bytes either.
docs/*.png binary
